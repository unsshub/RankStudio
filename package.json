{
  "name": "rankstudio",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,engine \"npm -w apps/web run dev\" \"npm -w apps/engine run dev\"",
    "engine": "npm -w apps/engine run start",
    "build": "npm -w packages/shared run build && npm -w packages/composition run build && npm -w apps/web run build && npm -w apps/engine run build",
    "test": "vitest run",
    "test:render": "npm -w apps/engine run test:render",
    "e2e": "playwright test",
    "typecheck": "tsc -b",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "ajv": "^8.17.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.4"
  }
}
